use rx::core::*;

fn step_0(mut x: u32, key: u32) -> u32 {
    if (x & 1u32) == 0u32 {
        x = x * 1u32 + key;
    } else {
        x = (x >> 1u32) ^ (x << 31u32) ^ key;
    }
    if (x & 2u32) == 0u32 {
        x = x * 35u32 + key;
    } else {
        x = (x >> 2u32) ^ (x << 30u32) ^ key;
    }
    if (x & 4u32) == 0u32 {
        x = x * 69u32 + key;
    } else {
        x = (x >> 3u32) ^ (x << 29u32) ^ key;
    }
    if (x & 8u32) == 0u32 {
        x = x * 103u32 + key;
    } else {
        x = (x >> 4u32) ^ (x << 28u32) ^ key;
    }
    if (x & 16u32) == 0u32 {
        x = x * 137u32 + key;
    } else {
        x = (x >> 5u32) ^ (x << 27u32) ^ key;
    }
    if (x & 32u32) == 0u32 {
        x = x * 171u32 + key;
    } else {
        x = (x >> 6u32) ^ (x << 26u32) ^ key;
    }
    if (x & 64u32) == 0u32 {
        x = x * 205u32 + key;
    } else {
        x = (x >> 7u32) ^ (x << 25u32) ^ key;
    }
    if (x & 128u32) == 0u32 {
        x = x * 239u32 + key;
    } else {
        x = (x >> 8u32) ^ (x << 24u32) ^ key;
    }
    if (x & 256u32) == 0u32 {
        x = x * 273u32 + key;
    } else {
        x = (x >> 9u32) ^ (x << 23u32) ^ key;
    }
    if (x & 512u32) == 0u32 {
        x = x * 307u32 + key;
    } else {
        x = (x >> 10u32) ^ (x << 22u32) ^ key;
    }
    if (x & 1024u32) == 0u32 {
        x = x * 341u32 + key;
    } else {
        x = (x >> 11u32) ^ (x << 21u32) ^ key;
    }
    if (x & 2048u32) == 0u32 {
        x = x * 375u32 + key;
    } else {
        x = (x >> 12u32) ^ (x << 20u32) ^ key;
    }
    x
}

