use rx::core::*;

fn main() {
    let a = get_i32() as isize;
    let b = get_i32() as isize;
    println_i32((a + b) as i32);
    println_i32((a - b) as i32);
    println_i32((a * b) as i32);
    println_i32((a / b) as i32);
    println_i32((a % b) as i32);
    println_i32((a & b) as i32);
    println_i32((a | b) as i32);
    println_i32((a ^ b) as i32);
    println_i32((!a) as i32);
    println_i32((a < b) as i32);
    println_i32((a <= b) as i32);
    println_i32((a > b) as i32);
    println_i32((a >= b) as i32);
    println_i32((a == b) as i32);
    println_i32((a != b) as i32);
    println_i32((-a) as i32);
}
