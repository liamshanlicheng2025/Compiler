use rx::core::*;

fn main() {
    let mut v = Vec::<usize>::new();
    println_i32(v.is_empty() as i32);
    let mut i = 0usize;
    while i < 100usize {
        v.push(v.len());
        i += 1usize;
    }
    println_i32(v.len() as i32);
    println_i32(v.remove(0) as i32);
    println_i32(v.remove(49) as i32);
    println_i32(v.remove(97) as i32);
    v[0] = 123;
    println_i32(v[0] as i32);
    println_i32(v[49] as i32);
    println_i32(Vec::<usize>::len(&v) as i32);
    Vec::<usize>::push(&mut v, 321);
    println_i32(v[97] as i32);
}
