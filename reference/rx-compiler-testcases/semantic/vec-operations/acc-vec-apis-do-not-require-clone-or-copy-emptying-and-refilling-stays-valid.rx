use rx::core::*;

struct Item {
    value: Box<i32>,
}
fn main() {
    let mut v = Vec::<Item>::new();
    println_i32(v.is_empty() as i32);
    v.push(Item {
        value: Box::<i32>::new(4),
    });
    v.push(Item {
        value: Box::<i32>::new(7),
    });
    println_i32(v.is_empty() as i32);
    let taken = v.remove(0);
    println_i32(*taken.value);
    println_i32(v.is_empty() as i32);
    println_i32(*v[0].value);
    v[0] = Item {
        value: Box::<i32>::new(9),
    };
    println_i32(*v.remove(0).value);
    println_i32(v.is_empty() as i32);
    v.push(taken);
    println_i32(v.is_empty() as i32);
    println_i32(*v[0].value);
}
