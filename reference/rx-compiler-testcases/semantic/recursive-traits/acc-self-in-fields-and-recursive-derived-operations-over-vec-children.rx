use rx::core::*;

#[derive(Clone, PartialEq, Eq)]
struct Node {
    value: i32,
    children: Vec<Self>,
}
fn leaf(x: i32) -> Node {
    Node {
        value: x,
        children: Vec::<Node>::new(),
    }
}
fn sum(n: &Node) -> i32 {
    let mut total = n.value;
    let mut i = 0usize;
    while i < n.children.len() {
        total += sum(&n.children[i]);
        i += 1usize;
    }
    total
}
fn main() {
    let mut root = leaf(1);
    let mut child = leaf(2);
    child.children.push(leaf(3));
    root.children.push(child);
    root.children.push(leaf(4));
    let mut copy = root.clone();
    println_i32((root == copy) as i32);
    copy.children[0].children[0].value = 20;
    println_i32(sum(&root));
    println_i32(sum(&copy));
    println_i32((root != copy) as i32);
}
