use rx::core::*;

fn main() {
    let mut a = 4;
    let b = 9;
    let refs = [&mut a, &b];
    println_i32(*refs[0] + *refs[1]);
    let mut c = 5;
    let refs2 = [&b, &mut c];
    println_i32(*refs2[0] + *refs2[1]);
    let mut d = 6;
    let r = if true { &mut d } else { &b };
    println_i32(*r);
    let mut e = 7;
    let r2 = if false { &b } else { &mut e };
    println_i32(*r2);
    let mut f = 8;
    let r3 = loop {
        if true {
            break &b;
        }
        break &mut f;
    };
    println_i32(*r3);
}
