use rx::core::*;

fn main() {
    println_i32(((-1i32 as i32) as i32) as i32);
    println_i32(((-1i32 as i32) as u32) as i32);
    println_i32(((-1i32 as i32) as isize) as i32);
    println_i32(((-1i32 as i32) as usize) as i32);
    println_i32(((-1i32 as u32) as i32) as i32);
    println_i32(((-1i32 as u32) as u32) as i32);
    println_i32(((-1i32 as u32) as isize) as i32);
    println_i32(((-1i32 as u32) as usize) as i32);
    println_i32(((-1i32 as isize) as i32) as i32);
    println_i32(((-1i32 as isize) as u32) as i32);
    println_i32(((-1i32 as isize) as isize) as i32);
    println_i32(((-1i32 as isize) as usize) as i32);
    println_i32(((-1i32 as usize) as i32) as i32);
    println_i32(((-1i32 as usize) as u32) as i32);
    println_i32(((-1i32 as usize) as isize) as i32);
    println_i32(((-1i32 as usize) as usize) as i32);
}
