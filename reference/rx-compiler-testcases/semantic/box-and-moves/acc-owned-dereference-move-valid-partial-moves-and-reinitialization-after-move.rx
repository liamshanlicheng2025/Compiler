use rx::core::*;

struct Parts {
    left: Box<i32>,
    right: Box<i32>,
}
fn choose(p: Parts, first: bool) -> Box<i32> {
    if first {
        return p.left;
    }
    p.right
}
fn main() {
    let mut a = Box::<i32>::new(7);
    let mut b = Box::<i32>::clone(&a);
    *b = 9;
    println_i32(*a);
    println_i32(*b);
    *a = 3;
    let wrapped = Box::<Parts>::new(Parts { left: a, right: b });
    let parts = *wrapped;
    let left = parts.left;
    let right = parts.right;
    println_i32(*left + *right);
    let p = Parts {
        left: left,
        right: right,
    };
    println_i32(*choose(p, false));
    let mut moved = Box::<i32>::new(1);
    let old = moved;
    moved = Box::<i32>::new(8);
    println_i32(*old);
    println_i32(*moved);
}
