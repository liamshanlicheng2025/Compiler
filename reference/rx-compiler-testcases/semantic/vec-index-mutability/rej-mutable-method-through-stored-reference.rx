use rx::core::*;

struct Counter {
    value: i32,
}
impl Counter {
    fn increment(&mut self) {
        self.value += 1;
    }
}
fn update(values: Vec<&mut Counter>) {
    values[0].increment();
}
fn main() {
    let mut counter = Counter { value: 1 };
    let mut values = Vec::<&mut Counter>::new();
    values.push(&mut counter);
    update(values);
}
