use rx::core::*;

fn main() {
    let mut i = 0;
    let mut sum = 0;
    while {
        i += 1;
        i <= 5
    } {
        if i == 2 {
            continue;
        }
        let mut j = 0;
        loop {
            j += 1;
            if j == 3 {
                break;
            }
            sum += i * j;
        }
    }
    let v: i32 = loop {
        loop {
            break;
        }
        break sum;
    };
    println_i32(i);
    println_i32(v);
    while loop {
        break false;
    } {
        println_i32(999);
    }
}
