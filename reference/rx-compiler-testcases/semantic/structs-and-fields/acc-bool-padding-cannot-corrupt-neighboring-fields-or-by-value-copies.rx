use rx::core::*;

#[derive(Clone, Copy)]
struct S {
    small: bool,
    x: i32,
    tail: bool,
    y: [i32; 2],
}
fn mark(x: i32) -> i32 {
    println_i32(x);
    x
}
fn change(mut s: S) -> S {
    s.x = 99;
    s.y[1] = 77;
    s
}
fn main() {
    let s = S {
        y: [mark(1), mark(2)],
        tail: true,
        x: mark(3),
        small: false,
    };
    let mut t = change(s);
    println_i32(s.x);
    println_i32(s.y[1]);
    println_i32(t.x);
    println_i32(t.y[1]);
    t = s;
    println_i32(t.x);
    println_i32(t.tail as i32);
    println_i32(t.small as i32);
}
