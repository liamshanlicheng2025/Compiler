use rx::core::*;

#[derive(Clone, Copy)]
struct Packet {
    data: [i32; 8],
    flag: bool,
}
#[derive(Clone, Copy)]
struct View<'a> {
    data: &'a [i32; 8],
    tag: i32,
}
fn edit(mut p: Packet, tail: i32) -> Packet {
    p.data[7] += tail;
    p.flag = !p.flag;
    p
}
fn make(x: i32) -> Packet {
    Packet {
        data: [x; 8],
        flag: true,
    }
}
fn main() {
    let a = make(get_i32());
    let b = edit(a, 4);
    let v = View {
        data: &a.data,
        tag: 2,
    };
    let copy = v;
    println_i32(v.data[7]);
    println_i32(copy.data[7]);
    println_i32(b.data[7]);
    println_i32(a.flag as i32);
    println_i32(b.flag as i32);
    let mut arrays = [[1, 2], [3, 4]];
    let saved = arrays;
    arrays = [[5, 6], [7, 8]];
    println_i32(saved[1][1]);
    println_i32(arrays[1][1]);
}
