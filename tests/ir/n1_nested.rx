fn main() {
    let mut i = 0;
    let mut found = 0;
    while (i < 10) {
        let mut j = 0;
        while (j < 10) {
            if (i * j == 12) {
                found = i * 10 + j;
                break;
            }
            j += 1;
        }
        i += 1;
    }
    printlnInt(found);
}
