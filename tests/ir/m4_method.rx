struct Point { x: i32, y: i32 }
impl Point {
    fn new(x: i32, y: i32) -> Point { Point { x: x, y: y } }
    fn sum(&self) -> i32 { self.x + self.y }
    fn scale(&mut self, k: i32) { self.x = self.x * k; self.y = self.y * k; }
}
fn main() {
    let mut p = Point::new(3, 4);
    p.scale(2);
    printlnInt(p.sum());
    printlnInt(p.sum());
}
